# Installed locally with pnpm; never committed.
node_modules/

# Written by pnpm itself; builds ignore it.
pnpm-workspace.yaml

# Platform-owned SDK, type-check configuration and import map (regenerated on
# checkout and deploy).
.hatch/

# Connect codegen output (regenerated from proto/ by the platform on build).
gen/

# Native runtime configuration the platform generates on checkout and deploy,
# and NSH's caches.
/nsh.json
/app/tsconfig.json
.nsh/
