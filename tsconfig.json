{
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "packages/hatch-cli/src/**/*.ts",
    "packages/hatch-design-tokens/src/**/*.ts",
    "packages/hatch-design-tokens/test/**/*.ts",
    "sdk-internal/ui/theme/**/*.ts",
    "sdk-internal/ui/scripts/**/*.ts",
    "sdk-internal/ui/test/*.ts",
    "sdk-internal/ui/gallery/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.browser.config.ts",
    "vitest.browser.setup.ts",
    "postcss.config.ts",
    "drizzle.config.ts",
    // Unit tests import `@hatch/app/native`, which imports the NSH runtime's
    // `nsh` module; this declares the part it uses.
    "sdk-internal/app/src/nsh-host.d.ts"
  ],
  // NSH TSX fixtures are checked by `nsh check` in the tests that build them.
  "exclude": ["src/**/test-fixtures/native-*/**"],

  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "~*": ["./src/*"]
    }
  }
}
