{
  "name": "@hatch/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "check:types": "tsc --noEmit",
    "export:ios": "expo export --platform ios",
    "eas": "pnpm --config.ignore-scripts=true dlx eas-cli@27.5.0",
    "release:ios": "pnpm eas build --platform ios --profile production --auto-submit",
    "submit:ios": "pnpm eas submit --platform ios --profile production",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@bufbuild/protovalidate": "^1.3.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-web": "^2.3.0",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/ui": "~58.0.29",
    "@hatch/platform-api": "workspace:*",
    "@tanstack/react-query": "^5.108.1",
    "expo": "58.0.26",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1"
  }
}
